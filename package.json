  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "typescript": "~5.9.3",
    "babel-preset-expo": "~58.0.17",
    "@react-native/jest-preset": "0.88.0",
    "test-renderer": "1.3.0",
    "tar": "7.5.22",
