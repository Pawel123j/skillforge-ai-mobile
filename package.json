  "private": true,
  "overrides": {
    "react-native": "$react-native",
    "react": "$react",
    "uuid": "11.1.1",
    "sprintf-js": "1.1.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
